# Copy this to .env and fill in values

# Server
PORT=3001

# CORS — comma-separated origins, or "*" for everything
# In production: https://norcalthrifting.com,https://www.norcalthrifting.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Turso database (libSQL)
# Get these from: https://app.turso.tech → your database → Connect
# For local dev only (no Turso account): omit both vars and a local file:./data/sales.db is used
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# JWT secret — sign with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in production. The dev fallback is insecure.
JWT_SECRET=changeme-generate-a-real-secret

# JWT token lifetime (ms-style: 30d, 7d, 24h)
JWT_EXPIRES_IN=30d

# Comma-separated emails that are automatically granted admin role on sign-up.
ADMIN_EMAILS=voblak2@gmail.com

# Google Sign-In — OAuth client ID from Google Cloud Console (Credentials ->
# OAuth client ID -> Web application). Same value as the frontend's
# VITE_GOOGLE_CLIENT_ID; used here as the expected audience when verifying a
# Google ID token. No client secret is needed for this flow.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Cron schedule for auto-refresh (default: 6 AM daily)
# Format: minute hour day month day-of-week
# Examples: "0 */6 * * *" = every 6 hours, "0 6,18 * * *" = 6 AM and 6 PM
CRON_SCHEDULE=0 6 * * *

# Cloudflare R2 (photo uploads) — S3-compatible object storage
# Get these from the Cloudflare dashboard: R2 → Manage API Tokens (account ID is shown on the R2 overview page)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=norcal-thrifting-photos
# Public base URL for the bucket (r2.dev dev subdomain or a custom domain) — no trailing slash
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Contact form email (Resend) — optional. Without RESEND_API_KEY, the contact
# form still works: submissions are saved to the database and the message is
# logged to the console instead of emailed. Get a key from https://resend.com
# (free tier available). Sends come from hello@norcalthrifting.com, which
# must be a verified domain/sender in the Resend account this key belongs to.
# Render's free tier blocks outbound SMTP at the network level, which is why
# this goes through Resend's HTTPS API instead of SMTP.
RESEND_API_KEY=re_your_api_key_here
# Destination address for contact form submissions (defaults to hello@norcalthrifting.com)
CONTACT_TO_EMAIL=hello@norcalthrifting.com
